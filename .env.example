# PartProof environment configuration
# Copy to .env and adjust. Never commit .env with real secrets (Rule h).

# ── LLM Gateway ──
# Model tiers
MAIN_MODEL=claude-sonnet-5-5
FAST_MODEL=claude-haiku-5-5

# Fixture mode: when true, replays recorded JSON from data/fixtures (no API key needed)
FIXTURE_MODE=true

# Per-call timeout (seconds)
LLM_TIMEOUT_SECONDS=30

# Cost rates per 1K tokens (mock estimates for the hackathon)
MAIN_MODEL_INPUT_COST=0.003
MAIN_MODEL_OUTPUT_COST=0.015
FAST_MODEL_INPUT_COST=0.0008
FAST_MODEL_OUTPUT_COST=0.004

# Fixture root directory
FIXTURE_ROOT=data/fixtures

# ── API ──
# No secrets needed for skeleton; FastAPI runs on localhost:8000

# ── Database ──
# SQLite file path (relative to project root)
DB_PATH=data/partproof.db
